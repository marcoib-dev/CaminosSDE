# Base de datos PostgreSQL (Neon en producción)
# Los valores por defecto coinciden con docker-compose.yaml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/caminos_rurales?schema=public"

# Autenticación
JWT_SECRET="cambiar-por-una-clave-larga-y-aleatoria"
JWT_EXPIRES_IN="1d"

# Servidor
NODE_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Prioridad: distancia máxima (km) para sumar puntos por cercanía a puntos de interés
PRIORIDAD_UMBRAL_KM=1

# Usuario ADMIN inicial (lo usa prisma/seed.js)
ADMIN_NOMBRE="Administrador"
ADMIN_EMAIL="admin@caminosrurales.gob.ar"
ADMIN_PASSWORD="cambiar-esta-clave"

# Cloudinary (carga de fotos con subida firmada desde el backend)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
