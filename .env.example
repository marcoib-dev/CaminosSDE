# Base de datos (PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/caminos_rurales?schema=public

# API
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SHARED_SECRET=cambiar-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30
PRIORIDAD_UMBRAL_KM=1

# Seed
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=Cambiar123!

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambiar-por-otro-secreto-de-al-menos-32-caracteres

# Cloudinary (opcional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Observabilidad de la API (opcional)
SENTRY_DSN=
