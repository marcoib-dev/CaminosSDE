# Variables para docker-compose.prod.yaml.
# Copiar a .env.produccion (ignorado por git) y completar los secretos.

# --- PostgreSQL ---
# La contraseña se inserta dentro de DATABASE_URL: usá solo letras, números
# y guiones (sin @ : / # ni espacios).
POSTGRES_USER=caminos
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
POSTGRES_DB=caminos_rurales

# --- API ---
# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-por-64-caracteres-hexadecimales
JWT_EXPIRES_IN=1d

# Origen público exacto del frontend (CORS). Ejemplo:
# https://caminos.example.gob.ar
# Acepta varios orígenes separados por coma:
# http://192.168.1.36,http://ServerDebian.local
FRONTEND_URL=http://localhost

# Distancia máxima (km) para sumar prioridad por cercanía a puntos de interés.
PRIORIDAD_UMBRAL_KM=1

# --- Administrador inicial (lo usa `npm run seed`) ---
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@caminosrurales.gob.ar
ADMIN_PASSWORD=cambiar-esta-clave

# Con true, el seed crea el ADMIN y las categorías base, pero no los caminos
# ni los puntos de ejemplo. Recomendado en producción.
SEED_SIN_DEMO=true

# --- Cloudinary (fotos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend y puerto ---
# Ruta relativa: Nginx redirige /api/ al backend en la red interna.
VITE_API_URL=/api

# Interfaz y puerto del host donde Nginx publica el frontend.
# 127.0.0.1 si cloudflared/proxy corre en este host. Para un proxy externo,
# usá la IP privada del servidor (o 0.0.0.0) y restringí el puerto por firewall.
BIND_HOST=127.0.0.1
HTTP_PORT=80

# --- Cloudflare Tunnel (opcional como servicio de Compose) ---
# Token del túnel. Si usás cloudflared instalado en el host, dejàlo vacío.
# El ingress del túnel debe apuntar a http://frontend:8080.
CLOUDFLARE_TUNNEL_TOKEN=
