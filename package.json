{
  "name": "sistema-vial-sde",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @sde/db generate",
    "db:migrate": "pnpm --filter @sde/db migrate",
    "db:deploy": "pnpm --filter @sde/db deploy",
    "db:seed": "pnpm --filter @sde/db seed",
    "db:studio": "pnpm --filter @sde/db studio",
    "db:reset": "pnpm --filter @sde/db reset"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
